<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
      <meta name="theme-color" content="{{ settings.color_accent | default: '#1F6B4F' }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {{ content_for_header }}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    >

    {{ 'design-tokens.css' | asset_url | stylesheet_tag }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'component-library.css' | asset_url | stylesheet_tag }}
    {{ 'section-header-footer.css' | asset_url | stylesheet_tag }}
    {{ 'section-home.css' | asset_url | stylesheet_tag }}
    {{ 'cart-drawer.css' | asset_url | stylesheet_tag }}

    <style>
      :root {
        --color-bg: {{ settings.color_bg | default: '#FAFAF7' }};
        --color-surface: {{ settings.color_surface | default: '#FFFFFF' }};
        --color-text: {{ settings.color_text | default: '#1A1C19' }};
        --color-muted: {{ settings.color_muted | default: '#5C6358' }};
        --color-accent: {{ settings.color_accent | default: '#1F6B4F' }};
        --color-accent-soft: {{ settings.color_accent_soft | default: '#E7F2EC' }};
        --color-highlight: {{ settings.color_highlight | default: '#C45C26' }};
        --color-border: {{ settings.color_border | default: '#D9DED6' }};
      }
    </style>

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.JN = window.JN || {};
      window.JN.moneyFormat = {{ shop.money_format | json }};
      window.JN.cartCount = {{ cart.item_count | json }};
    </script>
  </head>

  <body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}">
    <a class="jn-skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}

    <script src="{{ 'global.js' | asset_url }}" defer></script>
    <script src="{{ 'cart-drawer.js' | asset_url }}" defer></script>
  </body>
</html>
