{% comment %}
  Reusable JustNatur button
  @param {string} label
  @param {string} [href]
  @param {string} [style] - primary | secondary | accent | ghost | light
  @param {string} [class]
  @param {string} [type] - button | submit
  @param {boolean} [block]
  @param {string} [attributes]
{% endcomment %}
{%- liquid
  assign style_name = style | default: 'primary'
  assign btn_class = 'jn-btn jn-btn--' | append: style_name
  if block
    assign btn_class = btn_class | append: ' jn-btn--block'
  endif
  if class != blank
    assign btn_class = btn_class | append: ' ' | append: class
  endif
-%}
{%- if href != blank -%}
  <a href="{{ href }}" class="{{ btn_class }}" {% if attributes %}{{ attributes }}{% endif %}>
    {{ label }}
  </a>
{%- else -%}
  <button type="{{ type | default: 'button' }}" class="{{ btn_class }}" {% if attributes %}{{ attributes }}{% endif %}>
    {{ label }}
  </button>
{%- endif -%}
