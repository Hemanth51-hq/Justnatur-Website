{% comment %}
  Section heading block used across homepage sections
{% endcomment %}
<div class="{{ class | default: '' }}">
  {%- if eyebrow != blank -%}
    <p class="jn-eyebrow">{{ eyebrow }}</p>
  {%- endif -%}
  {%- if heading != blank -%}
    <h2 class="{{ heading_class | default: 'h2' }}">{{ heading }}</h2>
  {%- endif -%}
  {%- if text != blank -%}
    <p class="jn-lede">{{ text }}</p>
  {%- endif -%}
</div>
