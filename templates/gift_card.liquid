{% layout none %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ gift_card.balance | money }} gift card — {{ shop.name }}</title>
  {{ 'design-tokens.css' | asset_url | stylesheet_tag }}
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ 'component-library.css' | asset_url | stylesheet_tag }}
</head>
<body class="jn-surface-cream" style="min-height:100vh;display:grid;place-items:center;padding:var(--jn-gutter)">
  <div class="jn-container jn-container--narrow" style="text-align:center">
    <p class="jn-eyebrow">{{ shop.name }}</p>
    <h1>Gift card</h1>
    <p class="jn-lede" style="margin-inline:auto">Balance: {{ gift_card.balance | money }}</p>
    {%- if gift_card.enabled -%}
      <p style="margin-top:var(--jn-space-6);font-family:var(--jn-font-display);font-size:var(--jn-text-2xl)">{{ gift_card.code | format_code }}</p>
    {%- endif -%}
  </div>
</body>
</html>
