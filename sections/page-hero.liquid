<section class="jn-page-hero" id="PageHero-{{ section.id }}">
  <div class="jn-container">
    <div class="jn-page-hero__inner jn-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="jn-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1>{{ section.settings.heading | default: page.title | default: collection.title | default: product.title }}</h1>
      {%- if section.settings.text != blank -%}
        <p class="jn-lede">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page hero",
  "tag": "section",
  "class": "section-page-hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Page title"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Supporting text",
      "default": "Placeholder supporting copy for this page."
    }
  ],
  "presets": [
    {
      "name": "Page hero"
    }
  ]
}
{% endschema %}
