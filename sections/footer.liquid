<footer class="jn-footer">
  <div class="jn-container jn-container--wide">
    <div class="jn-footer__grid">
      <div>
        <p class="jn-footer__brand">{{ section.settings.brand_name | default: settings.brand_name | default: shop.name }}</p>
        <p class="jn-footer__tagline">{{ section.settings.tagline | default: settings.brand_tagline }}</p>
      </div>

      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <p class="jn-footer__heading">{{ block.settings.heading }}</p>
          <div class="jn-footer__links">
            {%- if block.type == 'menu' -%}
              {%- for link in block.settings.menu.links -%}
                <a href="{{ link.url }}">{{ link.title }}</a>
              {%- else -%}
                <a href="{{ routes.collections_url }}">Shop</a>
                <a href="/pages/about">About</a>
                <a href="/pages/contact">Contact</a>
              {%- endfor -%}
            {%- elsif block.type == 'text' -%}
              <div>{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    <div class="jn-footer__bottom">
      <p>{{ 'sections.footer.copyright_html' | t: year: 'now' | date: '%Y', shop_name: shop.name }}</p>
      <div class="jn-footer__social">
        {%- if settings.social_instagram != blank -%}
          <a href="{{ settings.social_instagram }}" rel="noopener" target="_blank">Instagram</a>
        {%- endif -%}
        {%- if settings.social_youtube != blank -%}
          <a href="{{ settings.social_youtube }}" rel="noopener" target="_blank">YouTube</a>
        {%- endif -%}
        {%- if settings.social_pinterest != blank -%}
          <a href="{{ settings.social_pinterest }}" rel="noopener" target="_blank">Pinterest</a>
        {%- endif -%}
        {%- if settings.social_instagram == blank and settings.social_youtube == blank and settings.social_pinterest == blank -%}
          <span>Social links in Theme settings</span>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "JustNatur"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Ritual care for hair that feels like you."
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Explore"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Contact"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>hello@justnatur.example</p>"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "menu",
        "settings": {
          "heading": "Explore"
        }
      },
      {
        "type": "menu",
        "settings": {
          "heading": "Help"
        }
      },
      {
        "type": "text",
        "settings": {
          "heading": "Contact",
          "text": "<p>hello@justnatur.example</p>"
        }
      }
    ]
  }
}
{% endschema %}
