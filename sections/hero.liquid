<section class="jn-hero jn-section--flush" id="Hero-{{ section.id }}">
  <div class="jn-hero__media" aria-hidden="{% if section.settings.video == blank and section.settings.image == blank %}false{% else %}true{% endif %}">
    {%- if section.settings.video != blank -%}
      <video autoplay muted loop playsinline poster="{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 2000 }}{% endif %}">
        {%- for source in section.settings.video.sources -%}
          <source src="{{ source.url }}" type="{{ source.mime_type }}">
        {%- endfor -%}
      </video>
    {%- elsif section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '750, 1100, 1500, 1800, 2400',
          sizes: '100vw',
          alt: section.settings.image.alt | default: section.settings.brand_name | escape
      }}
    {%- else -%}
      <div class="jn-media__placeholder" style="position:absolute;inset:0">
        <span>Upload a full-bleed hero image or video in Theme Editor</span>
      </div>
    {%- endif -%}
    <div class="jn-hero__scrim"></div>
  </div>

  <div class="jn-hero__content jn-reveal">
    <p class="jn-hero__brand">{{ section.settings.brand_name }}</p>
    <h1 class="jn-hero__headline">{{ section.settings.headline }}</h1>
    {%- if section.settings.text != blank -%}
      <p class="jn-hero__text">{{ section.settings.text }}</p>
    {%- endif -%}
    <div class="jn-btn-group">
      {%- if section.settings.primary_label != blank -%}
        {% render 'button',
          label: section.settings.primary_label,
          href: section.settings.primary_link | default: routes.collections_url,
          style: 'light'
        %}
      {%- endif -%}
      {%- if section.settings.secondary_label != blank -%}
        {% render 'button',
          label: section.settings.secondary_label,
          href: section.settings.secondary_link | default: '#',
          style: 'ghost-light'
        %}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background video"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name (hero-level)",
      "default": "JustNatur"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Hair rituals rooted in nature"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Supporting text",
      "default": "Clean formulas, calm routines, and lasting softness — made for everyday care."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary CTA label",
      "default": "Shop the ritual"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary CTA link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary CTA label",
      "default": "Our story"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary CTA link"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
