<section class="jn-featured jn-section jn-surface-{{ section.settings.surface }}" id="Featured-{{ section.id }}">
  <div class="jn-container">
    <div class="jn-featured__head jn-reveal">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="jn-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.text != blank -%}
        <p class="jn-lede">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    <div class="jn-featured__grid">
      {%- if section.settings.collection != blank -%}
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          <div class="jn-reveal">
            {% render 'product-card', product: product, show_add: section.settings.show_add, badge: section.settings.badge %}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          <div class="jn-reveal" {{ block.shopify_attributes }}>
            {% render 'product-card',
              product: block.settings.product,
              badge: block.settings.badge,
              show_add: section.settings.show_add,
              placeholder_title: block.settings.placeholder_title,
              placeholder_meta: block.settings.placeholder_meta,
              placeholder_price: block.settings.placeholder_price
            %}
          </div>
        {%- else -%}
          {%- for i in (1..4) -%}
            <div class="jn-reveal">
              {% render 'product-card',
                show_add: true,
                placeholder_title: 'Signature formula',
                placeholder_meta: 'Placeholder product',
                placeholder_price: '₹1,499'
              %}
            </div>
          {%- endfor -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.cta_label != blank -%}
      <div class="jn-btn-group" style="margin-top: var(--jn-space-10); justify-content: center;">
        {% render 'button',
          label: section.settings.cta_label,
          href: section.settings.cta_link | default: routes.collections_url,
          style: 'secondary'
        %}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "tag": "section",
  "class": "section-featured",
  "settings": [
    {
      "type": "select",
      "id": "surface",
      "label": "Background",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "white", "label": "White" },
        { "value": "mint", "label": "Mint" }
      ],
      "default": "white"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Start with the essentials"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Four considered formulas for clean, resilient hair — replace these with live products in Theme Editor."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Default badge"
    },
    {
      "type": "checkbox",
      "id": "show_add",
      "label": "Show add button",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Section CTA",
      "default": "Shop all"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Section CTA link"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge"
        },
        {
          "type": "text",
          "id": "placeholder_title",
          "label": "Placeholder title",
          "default": "Nourish Shampoo"
        },
        {
          "type": "text",
          "id": "placeholder_meta",
          "label": "Placeholder meta",
          "default": "Gentle cleanse"
        },
        {
          "type": "text",
          "id": "placeholder_price",
          "label": "Placeholder price",
          "default": "₹1,499"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured products",
      "blocks": [
        { "type": "product", "settings": { "placeholder_title": "Nourish Shampoo", "placeholder_meta": "Gentle cleanse", "badge": "Best seller" } },
        { "type": "product", "settings": { "placeholder_title": "Restore Conditioner", "placeholder_meta": "Soft finish" } },
        { "type": "product", "settings": { "placeholder_title": "Scalp Serum", "placeholder_meta": "Daily balance" } },
        { "type": "product", "settings": { "placeholder_title": "Leave-in Mist", "placeholder_meta": "Light moisture" } }
      ]
    }
  ]
}
{% endschema %}
