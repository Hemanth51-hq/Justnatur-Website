<section class="jn-video jn-section jn-surface-{{ section.settings.surface }}" id="Video-{{ section.id }}">
  <div class="jn-container {% if section.settings.wide %}jn-container--wide{% endif %}">
    <div class="jn-video__frame jn-reveal">
      {%- if section.settings.video != blank -%}
        <video controls playsinline poster="{% if section.settings.poster != blank %}{{ section.settings.poster | image_url: width: 1800 }}{% endif %}">
          {%- for source in section.settings.video.sources -%}
            <source src="{{ source.url }}" type="{{ source.mime_type }}">
          {%- endfor -%}
        </video>
      {%- elsif section.settings.video_url != blank -%}
        <video controls playsinline poster="{% if section.settings.poster != blank %}{{ section.settings.poster | image_url: width: 1800 }}{% endif %}">
          <source src="{{ section.settings.video_url }}" type="video/mp4">
        </video>
      {%- elsif section.settings.poster != blank -%}
        {{
          section.settings.poster
          | image_url: width: 1800
          | image_tag: loading: 'lazy', widths: '600, 1000, 1400, 1800', sizes: '100vw', alt: section.settings.heading | escape
        }}
        <button class="jn-video__play" type="button" aria-label="{{ 'general.accessibility.play_video' | t }}">
          <span class="jn-video__play-icon">{% render 'icon', name: 'play' %}</span>
        </button>
      {%- else -%}
        <div class="jn-media__placeholder" style="position:absolute;inset:0">
          <span>Add video or poster image in Theme Editor</span>
        </div>
      {%- endif -%}
    </div>
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="jn-video__caption jn-reveal">
        {% render 'section-heading',
          eyebrow: section.settings.eyebrow,
          heading: section.settings.heading,
          text: section.settings.text
        %}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Video moment",
  "tag": "section",
  "class": "section-video",
  "settings": [
    {
      "type": "select",
      "id": "surface",
      "label": "Background",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "white", "label": "White" },
        { "value": "mint", "label": "Mint" }
      ],
      "default": "white"
    },
    {
      "type": "checkbox",
      "id": "wide",
      "label": "Wide container",
      "default": true
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify-hosted video"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "External MP4 URL",
      "info": "Optional fallback if not using Shopify video"
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Poster image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "In motion"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See the ritual"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "A quiet look at how JustNatur fits into an ordinary morning."
    }
  ],
  "presets": [
    {
      "name": "Video moment"
    }
  ]
}
{% endschema %}
