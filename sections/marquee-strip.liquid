<section class="jn-marquee jn-section--flush" id="Marquee-{{ section.id }}" aria-label="{{ section.settings.heading | default: 'Highlights' }}">
  <div class="jn-marquee__track">
    {%- for block in section.blocks -%}
      <span class="jn-marquee__item" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
    {%- endfor -%}
    {%- for block in section.blocks -%}
      <span class="jn-marquee__item" aria-hidden="true">{{ block.settings.text }}</span>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Marquee strip",
  "tag": "section",
  "class": "section-marquee",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Accessibility label",
      "default": "Brand highlights"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Clean botanicals"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee strip",
      "blocks": [
        { "type": "item", "settings": { "text": "Clean botanicals" } },
        { "type": "item", "settings": { "text": "Soft scalp care" } },
        { "type": "item", "settings": { "text": "Everyday rituals" } },
        { "type": "item", "settings": { "text": "Thoughtful formulas" } },
        { "type": "item", "settings": { "text": "Made to last" } }
      ]
    }
  ]
}
{% endschema %}
