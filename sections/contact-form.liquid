<section class="jn-section jn-surface-white" id="Contact-{{ section.id }}">
  <div class="jn-container">
    <div class="jn-split">
      <div class="jn-reveal">
        {% render 'section-heading',
          eyebrow: section.settings.eyebrow,
          heading: section.settings.heading,
          text: section.settings.text
        %}
        <div class="jn-cart-info" style="margin-top:var(--jn-space-8)">
          {%- if section.settings.email != blank -%}
            <div class="jn-cart-info__row">
              <span><strong>Email</strong><br>{{ section.settings.email }}</span>
            </div>
          {%- endif -%}
          {%- if section.settings.phone != blank -%}
            <div class="jn-cart-info__row">
              <span><strong>Phone</strong><br>{{ section.settings.phone }}</span>
            </div>
          {%- endif -%}
          {%- if section.settings.hours != blank -%}
            <div class="jn-cart-info__row">
              <span><strong>Hours</strong><br>{{ section.settings.hours }}</span>
            </div>
          {%- endif -%}
        </div>
      </div>

      <div class="jn-reveal">
        {% form 'contact', class: 'jn-contact-form' %}
          {%- if form.posted_successfully? -%}
            <p>{{ section.settings.success_message }}</p>
          {%- else -%}
            <div class="jn-field">
              <label for="ContactName-{{ section.id }}">{{ section.settings.name_label }}</label>
              <input id="ContactName-{{ section.id }}" type="text" name="contact[name]" required>
            </div>
            <div class="jn-field">
              <label for="ContactEmail-{{ section.id }}">{{ section.settings.email_label }}</label>
              <input id="ContactEmail-{{ section.id }}" type="email" name="contact[email]" required>
            </div>
            <div class="jn-field">
              <label for="ContactMessage-{{ section.id }}">{{ section.settings.message_label }}</label>
              <textarea id="ContactMessage-{{ section.id }}" name="contact[body]" required></textarea>
            </div>
            <button class="jn-btn jn-btn--primary" type="submit">{{ section.settings.submit_label }}</button>
          {%- endif -%}
        {% endform %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "class": "section-contact",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Contact"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We’d love to hear from you"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Placeholder contact copy — update details and form labels in Theme Editor."
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email display",
      "default": "hello@justnatur.example"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone display",
      "default": "+91 00000 00000"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Hours",
      "default": "Mon–Fri, 10am–6pm IST"
    },
    {
      "type": "text",
      "id": "name_label",
      "label": "Name label",
      "default": "Name"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "message_label",
      "label": "Message label",
      "default": "Message"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit label",
      "default": "Send message"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks — we’ll be in touch soon."
    }
  ],
  "presets": [
    {
      "name": "Contact form"
    }
  ]
}
{% endschema %}
