<section class="jn-section jn-surface-cream" id="Richtext-{{ section.id }}">
  <div class="jn-container {% if section.settings.narrow %}jn-container--narrow{% endif %}">
    <div class="jn-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="jn-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      <div class="jn-lede" style="max-width:none">
        {{ section.settings.body }}
      </div>
      {%- if section.settings.button_label != blank -%}
        <div style="margin-top:var(--jn-space-8)">
          {% render 'button',
            label: section.settings.button_label,
            href: section.settings.button_link | default: '#',
            style: section.settings.button_style
          %}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "tag": "section",
  "class": "section-richtext",
  "settings": [
    {
      "type": "checkbox",
      "id": "narrow",
      "label": "Narrow width",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "About JustNatur"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Care that respects the pace of real life"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>JustNatur is a placeholder story about calm, botanical hair care. Replace this copy in the Theme Editor with your brand narrative, values, and origin.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "primary"
    }
  ],
  "presets": [
    {
      "name": "Rich text"
    }
  ]
}
{% endschema %}
